# ─── Monday.com ───────────────────────────────────────────────────────────────
# Get from: monday.com → Profile picture → Admin → API → Personal API Token
MONDAY_API_TOKEN=

# ─── GNews ────────────────────────────────────────────────────────────────────
# Get from: https://gnews.io → Sign up → Dashboard → API Key
# Free tier: 100 requests/day — sufficient for personal use
GNEWS_API_KEY=

# ─── X (Twitter) API ──────────────────────────────────────────────────────────
# Get from: developer.x.com → Create app → Basic plan ($100/mo) → Bearer Token
# Required for the AI trends widget (X API free tier does not support search)
X_BEARER_TOKEN=

# ─── Optional overrides ───────────────────────────────────────────────────────
# Polling intervals in milliseconds (visible in browser bundle — no secrets here)
# NEXT_PUBLIC_MONDAY_POLL_MS=120000
# NEXT_PUBLIC_NEWS_POLL_MS=300000
